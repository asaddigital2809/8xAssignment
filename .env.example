# --- Database (Neon Postgres) -------------------------------------------------
# Vercel sets this automatically when the Neon store is connected.
DATABASE_URL=

# --- Auth.js -----------------------------------------------------------------
# Generate with: npx auth secret   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=
# Needed for `next start` outside Vercel (Vercel sets trust automatically).
AUTH_TRUST_HOST=true
# GitHub OAuth app (optional; the button only shows when both are set).
# Callback URL: <APP_URL>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Origin used in emailed links. Required in production (never derived from the Host header).
APP_URL=http://localhost:3000

# --- Email (SMTP) ------------------------------------------------------------
# Ethereal test inbox: run `npm run email:ethereal` and paste the printed values.
# Without SMTP_HOST in development, emails are printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="amzn.clone <no-reply@amzn.clone>"
